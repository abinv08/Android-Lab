<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dashboard Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#142B4A"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PARKING MANAGEMENT"
                android:textColor="#A9C5E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Parking Slot Manager"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Manage vehicles. Track spaces. Park smarter."
                android:textColor="#D2DEEE"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#244667"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="●  LIVE PARKING OVERVIEW"
                android:textColor="#8FF0B2"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Parking Overview"
            android:textColor="#142B4A"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Current slot availability and occupancy"
            android:textColor="#738197"
            android:textSize="13sp"/>

        <!-- Statistics -->
        <TextView
            android:id="@+id/txtCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="Loading parking statistics..."
            android:textColor="#142B4A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="3dp"/>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Quick Actions"
            android:textColor="#142B4A"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose an operation to continue"
            android:textColor="#738197"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btnEntry"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#167D65"
            android:text="＋   Vehicle Entry / Allocate Slot"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#2457A7"
            android:text="↗   Vehicle Exit / Free Slot"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FFFFFF"
            android:elevation="2dp"
            android:text="◷   View Parking History"
            android:textAllCaps="false"
            android:textColor="#142B4A"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <!-- Parking Slot Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Parking Slots"
                android:textColor="#142B4A"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DDEBE7"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="SLOT STATUS"
                android:textColor="#167D65"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Slot Legend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#20A477"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="18dp"
                android:text="Available"
                android:textColor="#46566C"
                android:textSize="12sp"/>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#E45C63"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Occupied"
                android:textColor="#46566C"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Existing Java/Kotlin code can populate this container -->
        <LinearLayout
            android:id="@+id/slotContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingBottom="24dp"/>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="PARKING SLOT MANAGER  •  DASHBOARD"
            android:textColor="#8A97A9"
            android:textSize="10sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

</ScrollView>
